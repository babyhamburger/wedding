# 服务端口
PORT=3000

# 对外访问地址（用于生成上传链接和二维码）。
# 本地演示可留空（自动用请求 Host）；生产填 https://photo.example.com
PUBLIC_URL=

# 存储模式: local | oss
STORAGE=local

# 婚礼标题（显示在上传页和大屏）
WEDDING_TITLE=张三 & 李四 婚礼
WEDDING_DATE=2026-09-23

# 管理页口令（必填，随机字符串）
ADMIN_TOKEN=change-me-please

# 阿里云 OSS（STORAGE=oss 时生效）
# Bucket 需配置 CORS：允许 PUT、来源 *（或站点域名）、允许头 Content-Type
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 公网访问域名，默认 https://{bucket}.{region}.aliyuncs.com
OSS_PUBLIC_BASE=
# object key 前缀
OSS_PREFIX=wedding
